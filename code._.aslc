int ldrPin = A0;
int ledPin = 9;
int lightValue = 0;
int threshold = 500;

void setup() {
  pinMode(ledPin, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  lightValue = analogRead(ldrPin);

  Serial.print("Light Value: ");
  Serial.println(lightValue);

  if (lightValue < threshold) {
    digitalWrite(ledPin, HIGH);  // Dark: light ON
  } else {
    digitalWrite(ledPin, LOW);   // Bright: light OFF
  }

  delay(500);
}
